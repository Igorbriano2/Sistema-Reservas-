# Servidor
NODE_ENV=development
PORT=3000

# Banco de dados: Supabase (Postgres) em todos os ambientes - nao usar o Managed
# Database da Digital Ocean em nenhuma configuracao.
#
# IMPORTANTE: o host de conexao DIRETA do Supabase (db.<projeto>.supabase.co) so
# tem endereco IPv6 - nao tem registro A (IPv4). A maioria das plataformas de deploy,
# incluindo a Digital Ocean App Platform, so tem saida IPv4, entao a conexao direta
# FALHA nelas. Use o "Connection Pooler" do Supabase, que tem host IPv4:
#   Supabase > Project Settings > Database > Connection string > "Session pooler"
#   (host tipo aws-0-<regiao>.pooler.supabase.com:5432, usuario "postgres.<ref-do-projeto>")
# Localmente, aponte para o mesmo projeto Supabase (nao ha Postgres local no MVP).
DATABASE_URL=postgres://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Autenticacao
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# URL publica do frontend admin, para restringir o CORS em producao.
# Vazio = aceita qualquer origem (ok para dev local).
CORS_ORIGIN=

# URL publica do frontend (normalmente a mesma do CORS_ORIGIN) - usada para montar o
# link publico de reserva que o agente envia ao cliente: "<WEB_APP_URL>/reservar/<token>".
WEB_APP_URL=

# Segredo do token de curta duracao (60min) do link publico de reserva. Se vazio, cai
# para JWT_SECRET. Gere com: openssl rand -hex 32
RESERVATION_LINK_SECRET=

# Segredo do login do painel da plataforma (/painel - clientes/assinaturas, separado
# do painel de cada restaurante). Se vazio, cai para JWT_SECRET. Gere com: openssl rand -hex 32
PLATAFORMA_JWT_SECRET=

# Tempo (ms) que o webhook espera apos a ultima mensagem de uma rajada antes de
# acionar o agente, agrupando mensagens seguidas do mesmo cliente numa unica resposta.
AGENT_DEBOUNCE_MS=6000

# Claude API (Anthropic) - obrigatorio para o agente conversacional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback do agente (doc 39) - opcional. Usado SO quando a chamada primaria falha de
# verdade (credito/billing, rate limit, indisponibilidade), pra conversa nao ficar sem
# resposta so por causa de uma unica API estar fora.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Qual das duas e a PRIMARIA ("anthropic" ou "openai") - a outra vira o fallback
# automatico. Troca reversivel sem deploy, so mudando essa variavel.
AGENT_PROVIDER_PRINCIPAL=anthropic

# Instagram - webhook (App Dashboard da Meta > Instagram > Webhooks)
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Chave para cifrar o access_token do Instagram no banco. Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Usado apenas pelo script de seed
SEED_ADMIN_EMAIL=admin@restaurante.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# Opcional, so pelo script de seed: cria o primeiro login do painel da plataforma
# (/painel) se as duas variaveis abaixo forem preenchidas. Deixe vazio pra pular.
SEED_PLATAFORMA_EMAIL=
SEED_PLATAFORMA_PASSWORD=

# Usados apenas pelo script `npm run instagram:connect` (conexao manual do MVP,
# nao ficam salvos em lugar nenhum alem de instagram_connections, ja cifrados)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Stripe (checkout/assinatura em /assinar) - chave SECRETA, nunca commitar valor real
# nem expor ao frontend (o frontend usa a chave PUBLICAVEL, em VITE_STRIPE_PUBLISHABLE_KEY
# no web/.env.example - essa sim pode ser publica).
STRIPE_SECRET_KEY=
# ID do produto no dashboard da Stripe (Product, nao Price).
STRIPE_PRODUCT_ID=
# Opcional: ID de um Price ja existente (recorrente, mensal, R$697). Se vazio, o
# backend procura um Price compativel no STRIPE_PRODUCT_ID e cria um na primeira vez.
STRIPE_PRICE_ID=
# Obtido depois de registrar o endpoint de webhook (/public/checkout/webhook) no
# dashboard da Stripe (Developers > Webhooks > Add endpoint), selecionando os eventos
# invoice.payment_succeeded, invoice.payment_failed, customer.subscription.updated e
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=

# Dias de tolerancia com uma assinatura "atrasada" (cobranca recorrente falhou) antes
# do painel da empresa ficar bloqueado. Opcional, default 5.
ASSINATURA_ATRASO_GRACE_DIAS=5
