# Servidor
NODE_ENV=development
PORT=3000

# Banco de dados: Supabase (Postgres) em todos os ambientes - nao usar o Managed
# Database da Digital Ocean em nenhuma configuracao. Pegue a connection string em
# Supabase > Project Settings > Database > Connection string (modo "Session", porta
# 5432; a Digital Ocean App Platform tem IP fixo por app, entao a conexao direta
# funciona sem precisar do Connection Pooler/porta 6543 do Supabase).
# Localmente, aponte para o mesmo projeto Supabase (nao ha Postgres local no MVP).
DATABASE_URL=postgres://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
DATABASE_SSL=true

# Autenticacao
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# URL publica do frontend admin, para restringir o CORS em producao.
# Vazio = aceita qualquer origem (ok para dev local).
CORS_ORIGIN=

# Claude API (Anthropic) - obrigatorio para o agente conversacional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Instagram - webhook (App Dashboard da Meta > Instagram > Webhooks)
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Chave para cifrar o access_token do Instagram no banco. Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Usado apenas pelo script de seed
SEED_ADMIN_EMAIL=admin@restaurante.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# Usados apenas pelo script `npm run instagram:connect` (conexao manual do MVP,
# nao ficam salvos em lugar nenhum alem de instagram_connections, ja cifrados)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
