# Servidor
NODE_ENV=development
PORT=3000

# Banco de dados (Digital Ocean Managed Postgres em producao)
DATABASE_URL=postgres://reservas:reservas@localhost:5432/reservas_dev
DATABASE_SSL=false

# Autenticacao
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# Claude API (Anthropic) - obrigatorio para o agente conversacional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Instagram (conexao manual no MVP - token colado aqui e gravado em instagram_connections)
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Usado apenas pelo script de seed
SEED_ADMIN_EMAIL=admin@restaurante.com
SEED_ADMIN_PASSWORD=troque-esta-senha
